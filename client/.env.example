# Copy to `.env.local` for local overrides.

# Base path for API calls. The default (`/api`) relies on the Vite dev proxy in
# development and on nginx in Docker; set an absolute URL only when the API is
# served from another origin.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api. Change if the server uses a
# non-default PORT.
VITE_API_PROXY_TARGET=http://localhost:4000
