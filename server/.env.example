# Copy to `.env` for local overrides. All values have safe defaults in
# `src/config/index.ts`, so the server starts with no .env at all.

NODE_ENV=development
PORT=4000

# Relative paths resolve against the `server/` package root.
DATABASE_PATH=./data/app.sqlite

# Comma-separated list of allowed browser origins (Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# debug | info | warn | error | silent
LOG_LEVEL=info

# Reverse proxies in front of the API (nginx in docker compose = 1). Controls
# how far X-Forwarded-For is trusted when deciding the client IP.
TRUST_PROXY_HOPS=1

# Rate limit on /api (per client IP). /api/health is exempt.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Largest accepted JSON request body.
JSON_BODY_LIMIT=10kb
