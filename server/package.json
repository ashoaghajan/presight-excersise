{
  "name": "presight-server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && yarn copy:sql",
    "copy:sql": "mkdir -p dist/db/migrations && cp -R src/db/migrations/. dist/db/migrations/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed/cli.ts",
    "db:reset": "yarn db:migrate --fresh && yarn db:seed",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@presight/shared": "1.0.0",
    "better-sqlite3": "~13.0.1",
    "cors": "~2.8.5",
    "express": "~5.1.0",
    "express-rate-limit": "~8.7.1",
    "helmet": "~8.3.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "~7.6.13",
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.1",
    "@types/node": "~22.20.1",
    "tsx": "~4.23.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.10"
  }
}
